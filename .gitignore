# Competition datasets are confidential. The CSVs the seed reads are tracked in this private repo,
# so a clone and a deploy both seed themselves: docs/adr/0004-datasets-in-the-private-repo.md. They
# are never copied, published or shared outside it, and agents still must not open them -- see
# .claude/hooks/protect-data.mjs.
datathon/data/*
!datathon/data/.gitkeep
datathon/.venv/
.ipynb_checkpoints/
__pycache__/

# Claude Code: personal settings, handoff notes, /fidelity screenshots
.claude/settings.local.json
.claude/handoff/
CLAUDE.local.md
