{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "healthLive",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness: the process is up.",
        "tags": [
          "health"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Readiness: dependencies are reachable (Compose healthcheck, k8s probe).",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Waypoint Compass API",
    "description": "Delivery planning for Waypoint Group (Tech Triathlon 2026). Conventions: specs/api-conventions.md.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-better-auth.session_token"
      }
    },
    "schemas": {
      "LinkDto": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string",
            "example": "/api/v1/orders/0192a3f4-7c1e-7a2b-9d3e-5f6a7b8c9d0e"
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PATCH",
              "PUT",
              "DELETE"
            ],
            "type": "string"
          },
          "title": {
            "type": "string",
            "example": "Cancel order"
          },
          "templated": {
            "type": "boolean"
          },
          "requires": {
            "example": [
              "If-Match",
              "reasonNote"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "href"
        ]
      },
      "NoticeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "ORDER_ROLLED_TO_NEXT_RUN"
          },
          "message": {
            "type": "string",
            "example": "Sent after the 4 PM cutoff: delivers Saturday."
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "MetaDto": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "example": "0192a3f5-1b2c-7d3e-8f4a-5b6c7d8e9f0a"
          },
          "serverTime": {
            "type": "string",
            "example": "2026-10-01T15:40:03+05:30"
          },
          "apiVersion": {
            "type": "string",
            "example": "1.0.0"
          },
          "notices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoticeDto"
            }
          }
        },
        "required": [
          "requestId",
          "serverTime",
          "apiVersion"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "lines[2].qty"
          },
          "code": {
            "type": "string",
            "example": "min"
          },
          "message": {
            "type": "string",
            "example": "Enter at least 1"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "ProblemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://compass.waypoint.lk/problems/validation-failed"
          },
          "title": {
            "type": "string",
            "example": "Some fields need attention"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/orders"
          },
          "requestId": {
            "type": "string",
            "example": "0192a3f5-1b2c-7d3e-8f4a-5b6c7d8e9f0a"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          },
          "violations": {
            "type": "array",
            "description": "PLAN_RULE_VIOLATION only: the broken rules",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance",
          "requestId"
        ]
      }
    }
  }
}
