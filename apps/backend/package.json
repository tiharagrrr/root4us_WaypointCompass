{
  "name": "@waypoint/api",
  "version": "0.0.1",
  "description": "Waypoint delivery planning API (NestJS + PostgreSQL)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "openapi:write": "nest build && node dist/openapi",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "dev": "nest start --watch",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:custom": "tsx scripts/db-generate.ts --custom",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset-demo": "tsx src/db/reset-demo.ts",
    "db:reset": "tsx src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:verify": "tsx src/db/verify-seed.ts",
    "db:fresh": "pnpm db:reset && pnpm db:verify",
    "db:studio": "drizzle-kit studio",
    "start:worker": "node dist/worker",
    "dev:worker": "nest start --watch --entryFile worker",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "tsx scripts/check-module-deps.ts",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^2.0.1",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "@waypoint/engine": "workspace:*",
    "@waypoint/shared": "workspace:*",
    "better-auth": "1.7.6",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.44.5",
    "express": "^5.2.1",
    "ioredis": "^5.7.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.m?js$": "<rootDir>/../test/esm-to-cjs.transform.cjs"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|better-auth|@better-auth|better-call|@thallesp|@noble|nanostores|jose|rou3|defu|kysely)[/@])"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "workerIdleMemoryLimit": "1GB",
    "setupFiles": [
      "<rootDir>/../test/setup-env.ts"
    ]
  }
}
