# ---------------------------------------------------------------------------
# Web app (Vite). Copy to apps/frontend/.env:
#   cp apps/frontend/.env.example apps/frontend/.env
#
# Vite reads .env files from this folder only, not the repo root. Only VITE_*
# variables reach browser code, and they are baked in at build time: never
# put a secret here.
# ---------------------------------------------------------------------------

# Origin prefixed to every API request by the API client's fetcher
# (specs/api-conventions.md). Leave empty for same-origin requests: in dev,
# vite.config.ts proxies /api to the API on :3000; in Docker, Caddy does.
VITE_API_BASE=
