{
  "name": "@waypoint/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared domain types, constraint rules and Zod schemas for Waypoint",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./domain": {
      "import": {
        "types": "./dist/domain.d.mts",
        "default": "./dist/domain.mjs"
      },
      "require": {
        "types": "./dist/domain.d.ts",
        "default": "./dist/domain.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
