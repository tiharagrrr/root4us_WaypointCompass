{
  "name": "@compass/api-client",
  "version": "0.0.1",
  "private": true,
  "description": "Typed client for the Waypoint Compass API, generated by orval from apps/backend/openapi.json: TanStack Query hooks, zod schemas and MSW handlers",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/mocks.ts",
    "./zod": "./src/zod.ts"
  },
  "scripts": {
    "generate": "orval --config ./orval.config.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.87.1",
    "@types/node": "^24.19.0",
    "orval": "^8.39.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.87.1"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "msw": "^2.15.0",
    "zod": "^4.6.5"
  }
}
