# Web entrypoint: serves the React PWA and proxies /api to NestJS on one
# origin (cookie sessions, no CORS). SITE_ADDRESS=":80" locally; set it to a
# domain (e.g. waypoint.example.com) in production for automatic HTTPS.
{
	admin off
}

{$SITE_ADDRESS::80} {
	# The SSE stream is never compressed: an encoder buffers, and frames must flush at once.
	@compressible not path /api/v1/streams/*
	encode @compressible zstd gzip

	# Readiness passthrough for the web app's status badge.
	handle /api/health {
		rewrite * /health
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle /api/v1/streams/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /sw.js Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
