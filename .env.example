# ---------------------------------------------------------------------------
# Waypoint environment. Copy to .env and adjust:  cp .env.example .env
# Defaults work out of the box with `docker compose up` (fully self-contained).
# Only the deployed environment points at Supabase / a real domain.
# ---------------------------------------------------------------------------

# --- Ports published on the host -------------------------------------------
# Web app + /api through Caddy -> http://localhost:8080
WEB_PORT=8080
# API directly (Swagger UI at http://localhost:3000/api/docs)
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Public URL -------------------------------------------------------------
# Caddy site address: ":80" for local HTTP; a domain for automatic HTTPS.
SITE_ADDRESS=:80
APP_URL=http://localhost:8080

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
# Used by the API, worker and seed. Inside Compose the host is `postgres`;
# for local `pnpm dev` against `pnpm infra:up` use localhost.
# Supabase: pooled URL (port 6543, ?pgbouncer=true) for the app; migrations
# need the direct/session URL (port 5432).
DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint

# --- Redis (BullMQ jobs, SSE pub/sub) ----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) -------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Session lifetime; long and sliding so drivers are not logged out mid-route.
SESSION_EXPIRES_IN_DAYS=7

# --- Seeded judge accounts (one per role) ------------------------------------
SEED_USER_PASSWORD=Waypoint@2026
SEED_DISPATCHER_USERNAME=dispatcher
SEED_LOADER_USERNAME=loader
SEED_DRIVER_USERNAME=driver
SEED_STORE_MANAGER_USERNAME=storemanager
# Folder with outlets.csv, vehicles.csv, calendar.csv, district_travel.csv,
# service_allowance.csv. Defaults to <repo>/data/seed.
# SEED_DATA_DIR=

# --- Object storage for proof of delivery (S3 API) --------------------------
# Local: MinIO container. Production: Supabase Storage S3 endpoint.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pod
S3_ACCESS_KEY_ID=waypoint
S3_SECRET_ACCESS_KEY=waypoint-secret
S3_FORCE_PATH_STYLE=true

# --- Demo ---------------------------------------------------------------------
# Override "now" (ISO 8601, Asia/Colombo) so judges can test the 4 PM cutoff
# and the Fresh 3:30-8:00 AM window at any time of day. Empty = real clock.
DEMO_CLOCK=

# --- Observability (docker compose --profile observability up) --------------
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
