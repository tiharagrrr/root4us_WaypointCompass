# ---------------------------------------------------------------------------
# Waypoint environment. Copy to .env and adjust:  cp .env.example .env
# Defaults work out of the box with `docker compose up` (fully self-contained).
# Only the deployed environment points at Supabase / a real domain.
#
# This file feeds Docker Compose and is the fallback for every app. To run an
# app on its own with different values, use its own example, which wins over
# this one: apps/backend/.env.example (API, worker, db scripts) and
# apps/frontend/.env.example (Vite).
# ---------------------------------------------------------------------------

# --- Ports published on the host -------------------------------------------
# Web app + /api through Caddy -> http://localhost:8080
WEB_PORT=8080
# API directly (Swagger UI at http://localhost:3000/api/docs)
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
# Object storage: the S3 API, and Garage's admin API (health, buckets, keys)
S3_PORT=9000
S3_ADMIN_PORT=9001

# --- Public URL -------------------------------------------------------------
# Caddy site address: ":80" for local HTTP; a domain for automatic HTTPS.
SITE_ADDRESS=:80
APP_URL=http://localhost:8080

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
# Three database roles, created on first start by deploy/db/init/00-roles.sh
# (elsewhere, run deploy/db/roles.sql once). If your volume predates them,
# recreate it: docker compose down -v.
COMPASS_OWNER_PASSWORD=compass_owner
COMPASS_APP_PASSWORD=compass_app
COMPASS_READONLY_PASSWORD=compass_readonly
# The API and worker connect as compass_app, filtered by row-level security.
# Inside Compose the host is `postgres`; for local `pnpm dev` against
# `pnpm infra:up` use localhost. Supabase: the pooled URL (port 6543).
DATABASE_URL=postgres://compass_app:compass_app@localhost:5432/waypoint
# Migrations, the seed and db:reset connect as compass_owner. Supabase: the
# direct or session URL (port 5432), never the transaction pooler.
DIRECT_URL=postgres://compass_owner:compass_owner@localhost:5432/waypoint

# Where there is no Postgres init hook (Railway), set this and run
# `node dist/db/bootstrap-roles.js` before the migration to create the three
# roles from Node. Off by default: creating a role needs CREATEROLE, which the
# migration role lacks on a managed Postgres such as Supabase.
DB_BOOTSTRAP_ROLES=false
# Optional admin connection for that bootstrap only; falls back to DIRECT_URL.
# ADMIN_URL=postgres://postgres:postgres@localhost:5432/waypoint

# --- Redis (BullMQ jobs, SSE pub/sub) ----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) -------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Session lifetime; long and sliding so drivers are not logged out mid-route.
SESSION_EXPIRES_IN_DAYS=7
# Origins besides APP_URL allowed to sign in, comma-separated. The Vite dev
# server (:5173) is trusted automatically outside production; add the address
# phones use on your network, e.g. http://192.168.1.20:5173, to test on a phone.
TRUSTED_ORIGINS=

# --- Seeded judge accounts (one per role, specs/identity/spec.md) ------------
# Rusiru (admin), Tihara (dispatcher), Nimesha (store manager), Harini (loader,
# PIN 2468 on dock-plg-01), Aniqa and Dinushi (drivers, code in the demo inbox).
SEED_PASSWORD=Waypoint@2026
# Folder with outlets.csv, vehicles.csv, calendar.csv, district_travel.csv,
# service_allowance.csv. Defaults to <repo>/data/seed.
# SEED_DATA_DIR=

# --- Object storage for proof of delivery (S3 API) --------------------------
# Local: the Garage container (deploy/s3/). Production: Supabase Storage.
S3_ENDPOINT=http://localhost:9000
# Must match s3_region in deploy/s3/garage.toml: SigV4 signs over the region.
S3_REGION=us-east-1
S3_BUCKET=pod
S3_ACCESS_KEY_ID=waypoint
# At least 16 characters; Garage refuses shorter secrets. The key is created on
# the first start and Garage cannot change its secret afterwards, so to rotate it
# pick a new S3_ACCESS_KEY_ID, or reset storage without touching the database:
#   docker compose rm -sf s3 s3-init && docker volume rm waypoint_s3meta waypoint_s3data
S3_SECRET_ACCESS_KEY=waypoint-dev-secret
S3_FORCE_PATH_STYLE=true
# Garage's own secrets; the container uses them, the API never sees them.
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
GARAGE_ADMIN_TOKEN=waypoint-admin-token

# --- Email (Resend) -----------------------------------------------------------
# resend sends real email; demo-inbox puts it in /api/v1/demo/inbox (DEMO_MODE).
# Empty: resend when RESEND_API_KEY is set, otherwise the demo inbox. With
# DEMO_MODE=true a copy of every email also lands in the demo inbox.
EMAIL_PROVIDER=
RESEND_API_KEY=
# On a domain verified in Resend; onboarding@resend.dev only reaches your own
# Resend account's address.
EMAIL_FROM=Waypoint Compass <onboarding@resend.dev>
# Signing secret (whsec_...) of the webhook at /api/v1/webhooks/resend, for
# delivery receipts, bounces and complaints.
RESEND_WEBHOOK_SECRET=

# --- SMS (sign-in codes, invitation links, the SMS channel of notifications) ---
# demo-inbox keeps every message on this machine at /api/v1/demo/inbox and
# needs DEMO_MODE=true: no account, no key, nothing leaves. It is the default
# because a real gateway needs a sender id its operator has approved, and that
# takes days - see the lead times below before planning a demo around one.
#   demo-inbox  nothing is sent; read codes at /api/v1/demo/inbox
#   notifylk    Notify.lk, local +94 routes, cheapest per message
#   textlk      Text.lk, the second local gateway, same price band
#   twilio      international numbers, or when neither local one will take the sender
SMS_PROVIDER=demo-inbox
# Notify.lk: sign up at notify.lk, then Settings for the user id and api key.
# The account works the day you make it, but only for numbers you verify in
# the dashboard; a custom mask (WayPoint) goes through the operators and takes
# roughly 3-7 business days, with a letter on company letterhead. Until it is
# approved, leave NOTIFYLK_SENDER_ID=NotifyDEMO and send only to your own
# verified numbers - a send to anyone else comes back "invalid number".
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO
# Text.lk: the same picture - a token works at once, a custom sender id needs
# the operators' approval. Its own test sender works without one.
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=
# Twilio: a trial account sends within minutes, but only to numbers verified in
# the console, and the From must be a Twilio number (or an MG... messaging
# service sid). Alphanumeric senders are not available for Sri Lanka.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Demo ---------------------------------------------------------------------
# Demo tools: the demo clock, and sign-in codes and emails going to
# /api/v1/demo/inbox instead of being sent.
DEMO_MODE=true
# Override "now" (ISO 8601, Asia/Colombo) so judges can test the 4 PM cutoff
# and the Fresh 3:30-8:00 AM window at any time of day. Honoured only when
# DEMO_MODE=true. Empty = real clock.
DEMO_CLOCK=
# With DEMO_MODE=true the worker moves running trips along their stops on the
# tracking map every 5 seconds. A trip whose driver's phone is reporting is left
# alone. false turns it off.
SIMULATE_POSITIONS=true

# --- Simulator (specs/simulation/spec.md) ---------------------------------------
# Drives a demo day through the real field-event handler. Needs DEMO_MODE=true
# as well; the run loop lives in the worker (pnpm --filter api dev:worker).
SIMULATION_ENABLED=false
# The scenario director's model. No model is called unless this is set AND an
# admin turns on "AI scenario director" in Settings.
LLM_PROVIDER=disabled  # disabled | scripted (keyless fake) | anthropic | openai-compatible
ANTHROPIC_API_KEY=
# LLM_MODEL defaults to claude-opus-5-5 on anthropic; openai-compatible has no
# default, so set it there.
# LLM_MODEL=claude-opus-5-5
# openai-compatible speaks the OpenAI chat completions API, so any of these
# work. The base URL carries the version path; the key is optional, because a
# local server does not ask for one.
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openai/gpt-4o
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=llama3.1  (no key)
LLM_BASE_URL=
LLM_API_KEY=

# --- Observability (docker compose --profile observability up) --------------
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# --- Tests --------------------------------------------------------------------
# The 41 API e2e suites (and the row-level-security suite) run only when these
# point at a MIGRATED local database; without them they call describe.skip and
# ~320 of the 423 backend tests are silently skipped. Run `pnpm infra:up` and
# `pnpm db:migrate` first, then:
#
#   TEST_DIRECT_URL=postgres://compass_owner:compass_owner@localhost:5432/waypoint \
#   TEST_DATABASE_URL=postgres://compass_app:compass_app@localhost:5432/waypoint \
#   TEST_REDIS_URL=redis://localhost:6379 \
#   pnpm --filter api test
#
# Match the port to POSTGRES_PORT/REDIS_PORT above if you changed them. The
# owner URL creates fixtures; the app URL is what the API itself connects as, so
# every query is checked against the row-level-security policies. Fixture ids
# carry a random suffix, so the suites can run repeatedly against one database.
TEST_DIRECT_URL=
TEST_DATABASE_URL=
TEST_REDIS_URL=
# Point this at a real object store to exercise S3StorageAdapter instead of the
# keyless local adapter the suites use by default.
TEST_S3_ENDPOINT=
