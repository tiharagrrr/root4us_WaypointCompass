# ---------------------------------------------------------------------------
# Waypoint environment. Copy to .env and adjust:  cp .env.example .env
# Defaults work out of the box with `docker compose up` (fully self-contained).
# Only the deployed environment points at Supabase / a real domain.
#
# This file feeds Docker Compose and is the fallback for every app. To run an
# app on its own with different values, use its own example, which wins over
# this one: apps/backend/.env.example (API, worker, db scripts) and
# apps/frontend/.env.example (Vite).
# ---------------------------------------------------------------------------

# --- Ports published on the host -------------------------------------------
# Web app + /api through Caddy -> http://localhost:8080
WEB_PORT=8080
# API directly (Swagger UI at http://localhost:3000/api/docs)
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
# Object storage: the S3 API, and Garage's admin API (health, buckets, keys)
S3_PORT=9000
S3_ADMIN_PORT=9001

# --- Public URL -------------------------------------------------------------
# Caddy site address: ":80" for local HTTP; a domain for automatic HTTPS.
SITE_ADDRESS=:80
APP_URL=http://localhost:8080

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
# Three database roles, created on first start by deploy/db/init/00-roles.sh
# (elsewhere, run deploy/db/roles.sql once). If your volume predates them,
# recreate it: docker compose down -v.
COMPASS_OWNER_PASSWORD=compass_owner
COMPASS_APP_PASSWORD=compass_app
COMPASS_READONLY_PASSWORD=compass_readonly
# The API and worker connect as compass_app, filtered by row-level security.
# Inside Compose the host is `postgres`; for local `pnpm dev` against
# `pnpm infra:up` use localhost. Supabase: the pooled URL (port 6543).
DATABASE_URL=postgres://compass_app:compass_app@localhost:5432/waypoint
# Migrations, the seed and db:reset connect as compass_owner. Supabase: the
# direct or session URL (port 5432), never the transaction pooler.
DIRECT_URL=postgres://compass_owner:compass_owner@localhost:5432/waypoint

# --- Redis (BullMQ jobs, SSE pub/sub) ----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) -------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Session lifetime; long and sliding so drivers are not logged out mid-route.
SESSION_EXPIRES_IN_DAYS=7
# Origins besides APP_URL allowed to sign in, comma-separated. The Vite dev
# server (:5173) is trusted automatically outside production; add the address
# phones use on your network, e.g. http://192.168.1.20:5173, to test on a phone.
TRUSTED_ORIGINS=

# --- Seeded judge accounts (one per role, specs/identity/spec.md) ------------
# Rusiru (admin), Tihara (dispatcher), Nimesha (store manager), Harini (loader,
# PIN 2468 on dock-plg-01), Aniqa and Dinushi (drivers, code in the demo inbox).
SEED_PASSWORD=Waypoint@2026
# Folder with outlets.csv, vehicles.csv, calendar.csv, district_travel.csv,
# service_allowance.csv. Defaults to <repo>/data/seed.
# SEED_DATA_DIR=

# --- Object storage for proof of delivery (S3 API) --------------------------
# Local: the Garage container (deploy/s3/). Production: Supabase Storage.
S3_ENDPOINT=http://localhost:9000
# Must match s3_region in deploy/s3/garage.toml: SigV4 signs over the region.
S3_REGION=us-east-1
S3_BUCKET=pod
S3_ACCESS_KEY_ID=waypoint
# At least 16 characters; Garage refuses shorter secrets. The key is created on
# the first start and Garage cannot change its secret afterwards, so to rotate it
# pick a new S3_ACCESS_KEY_ID, or reset storage without touching the database:
#   docker compose rm -sf s3 s3-init && docker volume rm waypoint_s3meta waypoint_s3data
S3_SECRET_ACCESS_KEY=waypoint-dev-secret
S3_FORCE_PATH_STYLE=true
# Garage's own secrets; the container uses them, the API never sees them.
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
GARAGE_ADMIN_TOKEN=waypoint-admin-token

# --- Demo ---------------------------------------------------------------------
# Demo tools: the demo clock, and sign-in codes and emails going to
# /api/v1/demo/inbox instead of being sent.
DEMO_MODE=true
# Override "now" (ISO 8601, Asia/Colombo) so judges can test the 4 PM cutoff
# and the Fresh 3:30-8:00 AM window at any time of day. Honoured only when
# DEMO_MODE=true. Empty = real clock.
DEMO_CLOCK=

# --- Observability (docker compose --profile observability up) --------------
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
